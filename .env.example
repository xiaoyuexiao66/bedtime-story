# 复制为 .env 后填写。.env 不要提交到 git，也不要发给别人。
ANTHROPIC_BASE_URL=https://token-plan.maas.qianwenaiapi.com/apps/anthropic
ANTHROPIC_API_KEY=在这里填你的 key
ANTHROPIC_MODEL=deepseek-v4.1-flash-1017

# auto = 有 ZipVoice 就用克隆，没有就退回系统语音
BEDTIME_TTS_ENGINE=auto
BEDTIME_TTS_THREADS=2
BEDTIME_TTS_NUM_STEPS=4

# 服务监听地址和端口
BEDTIME_HOST=0.0.0.0
BEDTIME_PORT=8000